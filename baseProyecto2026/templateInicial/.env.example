# =====================================================================
# .env.example - Plantilla del archivo .env
# =====================================================================
# Copiá este archivo como ".env" (sin la palabra example) y completalo
# con TUS datos:
#
#     cp .env.example .env
#
# El archivo .env NO se sube al repositorio (está en .gitignore)
# porque tiene contraseñas.
# =====================================================================

# --- BASE DE DATOS -----------------------------------------------------
# XAMPP/Laragon por defecto: root sin contraseña
DB_HOST=localhost
DB_NAME=contactos3
DB_USER=root
DB_PASS=
DB_PORT=3306
DB_CHARSET=utf8mb4

# --- CORREO ------------------------------------------------------------
# Gmail: smtp.gmail.com + puerto 587 + tls + "contraseña de aplicación"
# Outlook: smtp.office365.com + puerto 587 + tls
# MAIL_ENCRYPTION: tls (puerto 587) | ssl (puerto 465) | none
# OJO: en Gmail no va la contraseña normal de la cuenta, sino una
# "contraseña de aplicación" de 16 letras (seguridad.google.com, con la
# verificación en 2 pasos activada).
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@tuapp.local
MAIL_FROM_NAME="Gestion Personas y Ciudades"
# MAIL_DEBUG=true   escribe toda la conversación SMTP en el log
# MAIL_DRY_RUN=true NO envía el mail, solo lo simula (muy útil para probar)
MAIL_DEBUG=false
MAIL_DRY_RUN=true
# Archivo donde se anotan los mails (relativo a la raíz del proyecto).
# Se puede ver en vivo con:  tail -f lib/utils/mail.log
MAIL_LOG=lib/utils/mail.log

# --- ARCHIVOS ADJUNTOS -------------------------------------------------
# Carpeta donde se guardan las fotos (avatar) y los currículums (cv)
CARPETA_ARCHIVOS=files
# Tamaño máximo permitido por archivo, en megabytes.
# OJO: el límite real también depende de PHP (upload_max_filesize en php.ini,
# que en Linux suele venir en 2M). Si da "código de error: 1", es ese límite.
TAMANIO_MAXIMO_MB=3
