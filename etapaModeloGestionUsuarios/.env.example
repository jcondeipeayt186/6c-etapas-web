# Configuración de base de datos - ETAPA 5 Gestión Usuarios
# Copiar este archivo como .env y completar con tus credenciales
DB_HOST=localhost
DB_NAME=contactos5
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4
DB_PORT=3306

# --- Correo (lib/utils/mail.php) ---
# Gmail ejemplo: smtp.gmail.com:587 tls + App Password de 16 chars
# Outlook: smtp.office365.com:587
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM=noreply@tuapp.local
MAIL_FROM_NAME="Gestion 5"
MAIL_DEBUG=false
MAIL_DRY_RUN=true
# DRY_RUN=true simula envío y escribe en lib/utils/mail.log sin contactar SMTP (ideal para desarrollo)
